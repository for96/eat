{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/app.ts",
    "src/env.ts",
    "src/server.ts",
    "src/services/openfoodfacts.ts",
    "api/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "frontend"]
}
