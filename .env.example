# ─────────────────────────────────────────────────────────────────
# Pasto — esempio di env vars. Copia in .env per dev locale.
# Su Vercel: imposta queste tramite Dashboard → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────

# Database PostgreSQL.
# Locale: una qualunque Postgres (es. Neon connection string anche per dev).
# Produzione (Vercel): la stringa fornita da Vercel Postgres / Neon / Supabase.
# Su Neon usa il pool URL (?pgbouncer=true&connect_timeout=15).
DATABASE_URL="postgresql://user:pass@host:5432/pasto?sslmode=require"

# Solo per dev locale (Vercel ignora PORT/HOST):
PORT=3000
HOST=127.0.0.1

# CORS: comma-separated list, oppure "*" per dev.
# Su Vercel produzione metti l'URL stesso del deploy (es. https://pasto.vercel.app)
# o lascia "*" finché stai testando.
CORS_ORIGIN=*

# LLM provider: "stub" (default, no key) | "anthropic" (richiede ANTHROPIC_API_KEY)
LLM_PROVIDER=stub
# ANTHROPIC_API_KEY=

# OpenFoodFacts richiede uno User-Agent identificativo
OFF_USER_AGENT="Pasto/0.1 (contact@example.com)"

# ID utente di default (single-user mode). Se non esiste in DB viene creato al boot.
DEFAULT_USER_ID="default-user"
